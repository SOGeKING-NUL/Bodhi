SARVAM_API_KEY=
GOOGLE_API_KEY=

BODHI_VOICE_MODE=natural
BODHI_INPUT_DEVICE=2

DATABASE_URL=
# Max pooled Postgres connections. Must be >= the server's worker-thread count.
DB_POOL_MAX=20

REDIS_URL=

NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_FRONTEND_API_URL=

DEEPGRAM_API_KEY=

# ── Auth & CORS ──────────────────────────────────────────────────────────────
# Comma-separated list of origins allowed to call the API (browser CORS).
# Required in production. Wildcard "*" is NOT allowed with credentials.
BODHI_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Local development ONLY. When CLERK_FRONTEND_API_URL is unset, set this to
# "true" to allow unauthenticated requests (treated as user "anonymous").
# NEVER set this in production — the app will refuse to start without either
# CLERK_FRONTEND_API_URL or this flag.
BODHI_ALLOW_ANONYMOUS_AUTH=false

# ── External-call timeouts (seconds) ─────────────────────────────────────────
LLM_TIMEOUT_SEC=90
LLM_MAX_RETRIES=2
STT_TIMEOUT_SEC=60
TTS_TIMEOUT_SEC=60
EMBED_TIMEOUT_SEC=30

# ── Rate limiting ────────────────────────────────────────────────────────────
# Per-client default request rate. Set RATE_LIMIT_ENABLED=false to disable.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_DEFAULT=120/minute