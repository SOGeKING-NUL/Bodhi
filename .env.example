SARVAM_API_KEY=your_sarvam_api_key_here
SARVAM_STT_MODEL=saaras:v3
GOOGLE_API_KEY=your_google_api_key_here

# Deepgram streaming STT (live interview voice pipeline)
DEEPGRAM_API_KEY=your_deepgram_api_key_here
DEEPGRAM_MODEL=nova-3
DEEPGRAM_LANGUAGE=multi
DEEPGRAM_ENDPOINTING_MS=500
DEEPGRAM_UTTERANCE_END_MS=1500

# Sarvam Bulbul TTS (live interview voice pipeline — raw linear16 PCM streaming)
# Voice is actually chosen per-session from interviewer_persona (shubh/shreya);
# this is only the fallback default. Must be a bulbul:v3 speaker — v2 does not
# have "shubh"/"shreya".
SARVAM_TTS_VOICE=shubh
SARVAM_TTS_LANGUAGE=en-IN
SARVAM_TTS_MODEL=bulbul:v3
SARVAM_TTS_SAMPLE_RATE=22050

BODHI_VOICE_MODE=natural
BODHI_INPUT_DEVICE=2

DATABASE_URL=postgresql://user:pass@ep-xyz.aws.neon.tech/neondb?sslmode=require&channel_binding=require

REDIS_URL=redis://localhost:6379

NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_your_publishable_key_here
CLERK_SECRET_KEY=sk_test_your_secret_key_here
CLERK_FRONTEND_API_URL=https://your-app.clerk.accounts.dev
